#!/usr/bin/env python3
"""aikit acceptance gate: parse an acceptance report and say whether it may merge.

WHAT: Reads `<evidence>/<milestone>/verdict.json`, reads the owner's lifted
      findings from the tracker, prints the verdict text and returns 0 (may
      merge) or 1 (blocked).

WHY it is a program and not a paragraph in a skill.
      The acceptance phase asks the agent for three things it is most willing
      to skip: evidence attached to every claim, a mandatory "what I could not
      check" line, and five probes beyond the checklist. "Overall it works" is
      always the cheaper sentence to write. An instruction asking for them
      politely holds until the first long run. A non-zero exit code holds
      always. So A DEFECTIVE REPORT BLOCKS EXACTLY LIKE A BREAKAGE does:
      an acceptance run that never looked at the database has not earned the
      right to say "good".

      Two of the three finding classes block; "works, but awkward" does not.
      A gate where everything blocks becomes a gate nobody runs.

      Only the OWNER can lift a block, and lifting is written down. The escape
      hatch is mandatory because an acceptance agent does get things wrong —
      did not scroll, did not find the button — and without a way out one
      hallucination freezes the work until morning. The written record is
      mandatory for the opposite reason: it is the only way to see how often
      that happens.

HOW:  no third-party imports and no config file on purpose — the skill reads
      `aikit.yml` and passes what it found as flags. A binary that parsed YAML
      would need a dependency and would couple the gate to the config's shape.

    verdict template m52 > .acceptance/m52/verdict.json
    verdict gate m52
    verdict gate m52 --write --lang ru
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import unicodedata
from dataclasses import dataclass, field
from typing import Any

# -- the vocabulary -----------------------------------------------------------

# Machine keys, stable across languages. What the owner reads is looked up in
# LABELS; what the report file carries is one of these three. Accepting a
# localized word as input too (ALIASES) is deliberate: reports written before
# aikit existed are in Russian and must keep parsing.
BROKEN = "broken"
LIES = "lies"
CLUMSY = "clumsy"
CLASSES = (BROKEN, LIES, CLUMSY)
BLOCKING = (BROKEN, LIES)

# The five probes nothing in a specification asks for, and where the bugs
# actually live: focus lost after each keystroke, "please wait" where there is
# nothing to wait for, a lead with no recipient. A checklist cannot catch them
# by construction — it lists what should exist — so they are asked separately
# and a missing answer makes the report defective.
PROBES = (
    "empty_field",
    "very_long_text",
    "double_click",
    "abandon_midway",
    "browser_back",
)

# Evidence is a screenshot or a row from the database. The prefix is required
# so that "checked, works" cannot be typed into an evidence field as-is.
SCREEN = "screen:"
DB = "db:"

# The gate reads the report from the very directory it then searches for
# captures, so this name is guaranteed present on every run in every project
# with no write by anyone. `screen:verdict.json` therefore paid for a whole
# checklist from an otherwise empty directory — the fifth defeat of the
# evidence check, and the only one that needed no filesystem access at all.
REPORT_NAME = "verdict.json"

LABELS: dict[str, dict[str, str]] = {
    "en": {
        BROKEN: "does not work",
        LIES: "works, but lies",
        CLUMSY: "works, but awkward",
        "empty_field": "empty field",
        "very_long_text": "very long text",
        "double_click": "double click",
        "abandon_midway": "abandoned midway",
        "browser_back": "browser back button",
        "verdict": "Verdict",
        "good": "GOOD — may merge",
        "blocked": "BLOCKED",
        "blockers": "Blocking findings",
        "advisory": "For the owner (not blocking)",
        "defects": "Report defects",
        "lifted": "Lifted by the owner",
        "verified_fixed": "Fixed since the previous round",
        "not_checked": "Could not check",
        "spend": "Spend",
        "round": "round",
        "actions": "actions",
        "minutes": "minutes",
        "override_prefix": "lifted by owner:",
    },
    "ru": {
        BROKEN: "не работает",
        LIES: "работает, но врёт",
        CLUMSY: "работает, но неудобно",
        "empty_field": "пустое поле",
        "very_long_text": "очень длинный текст",
        "double_click": "двойное нажатие",
        "abandon_midway": "отказ на полпути",
        "browser_back": "кнопка назад",
        "verdict": "Вердикт",
        "good": "ГОДИТСЯ — можно мержить",
        "blocked": "ЗАБЛОКИРОВАНО",
        "blockers": "Находки, держащие мерж",
        "advisory": "Владельцу (не блокирует)",
        "defects": "Дефекты отчёта",
        "lifted": "Снято владельцем",
        "verified_fixed": "Починено с прошлого круга",
        "not_checked": "Чего проверить не смог",
        "spend": "Расход",
        "round": "круг",
        "actions": "действий",
        "minutes": "минут",
        "override_prefix": "снято владельцем:",
    },
}

# Localized words accepted in the report's `class` field, mapped back to the
# machine key. Reports written before aikit existed keep working.
ALIASES = {
    "не работает": BROKEN,
    "работает, но врёт": LIES,
    "врёт": LIES,
    "работает, но неудобно": CLUMSY,
    "неудобно": CLUMSY,
    "does not work": BROKEN,
    "broken": BROKEN,
    "lies": LIES,
    "clumsy": CLUMSY,
}

# Probe keys accepted from a report, localized or machine.
PROBE_ALIASES = {label: key for lang in LABELS.values()
                 for key, label in lang.items() if key in PROBES}
PROBE_ALIASES.update({key: key for key in PROBES})


def label(lang: str, key: str) -> str:
    return LABELS.get(lang, LABELS["en"]).get(key, LABELS["en"].get(key, key))


# -- the working tree ---------------------------------------------------------

def _matches(path: str, glob: str) -> bool:
    """A bare name matches any path component; anything with a `/` matches the
    whole path. `__pycache__` catches it at any depth, `build/*` only at the
    root — which is what people mean by each."""
    if "/" in glob:
        return fnmatch.fnmatch(path, glob)
    return any(fnmatch.fnmatch(part, glob) for part in path.split("/"))


def tree_state(cwd: pathlib.Path | None = None,
               ignore: tuple[str, ...] = ()) -> tuple[str, tuple[str, ...]]:
    """Fingerprint the repository's working state, and name what is dirty.

    The acceptance agent can edit this project — a shell alone is enough for
    that — and "you never fix anything, you only report" is an instruction it
    could talk itself out of on a long run. So the orchestrator records this
    before spawning it and passes it back with `--expect-tree`: if the tree
    moved while the run was happening, the gate blocks. Detection rather than
    prevention, but it lands on the one exit code that already stops a merge,
    which an instruction never does.

    `ignore` exists because USING a product mutates a repository — bytecode,
    build output, logs. Found the first time this ran for real: a reviewer ran
    the test suite, Python wrote a `.pyc`, and a run that edited nothing was
    called void. Anything git already ignores never appears here; this is for
    generated files a project happens to track.

    Returns the digest and the offending paths, because "the tree moved" that
    cannot say WHAT moved is a block nobody can act on.

    Raises so the caller can fail CLOSED — a check that could not run is not a
    check that passed, the same rule the whole phase is built on.
    """
    def git(*args: str) -> str:
        return subprocess.run(["git", *args], cwd=cwd, check=True, capture_output=True,
                              text=True, timeout=30).stdout

    dirty = []
    for line in git("status", "--porcelain").splitlines():
        status, path = line[:2], line[3:].strip()
        if " -> " in path:                      # a rename reports "old -> new"
            path = path.split(" -> ")[-1]
        path = path.strip('"')
        if any(_matches(path, g) for g in ignore):
            continue
        dirty.append(f"{status} {path}")
    dirty.sort()
    blob = git("rev-parse", "HEAD") + "\n" + "\n".join(dirty)
    return hashlib.sha256(blob.encode()).hexdigest()[:16], tuple(d[3:] for d in dirty)


def tree_digest(cwd: pathlib.Path | None = None,
                ignore: tuple[str, ...] = ()) -> str:
    return tree_state(cwd, ignore)[0]


class BadReport(ValueError):
    """The report does not parse. The message is shown to the author as-is."""


@dataclass(frozen=True)
class Finding:
    klass: str
    what: str
    where: str
    evidence: tuple[str, ...]


@dataclass(frozen=True)
class Item:
    """One line of the milestone's "done when" checklist, and its fate."""

    item: str
    passed: bool
    evidence: tuple[str, ...]


@dataclass(frozen=True)
class Report:
    milestone: str
    round: int
    checklist: tuple[Item, ...]
    findings: tuple[Finding, ...]
    not_checked: str
    probes: dict[str, str]
    # Round >= 2 confirms what the previous round found and the author has since
    # fixed. It needs a home of its own: without one an agent files it as a
    # finding — observed, filed as `clumsy` — which both misreports the class
    # and buries the one line telling the owner the loop is converging.
    verified_fixed: tuple[str, ...] = ()
    spend: dict[str, Any] = field(default_factory=dict)


@dataclass(frozen=True)
class Decision:
    blocked: bool
    blockers: tuple[Finding, ...]
    lifted: tuple[Finding, ...]
    defects: tuple[str, ...]
    advisory: tuple[Finding, ...]


# -- parsing ------------------------------------------------------------------

def _strs(raw: Any, where: str) -> tuple[str, ...]:
    if raw is None:
        return ()
    if not isinstance(raw, list) or any(not isinstance(x, str) for x in raw):
        raise BadReport(f"{where}: expected a list of strings")
    return tuple(x.strip() for x in raw if x.strip())


def parse(data: Any) -> Report:
    """Strict on purpose: the report is a protocol between the acceptance agent
    and this gate, and a field swallowed quietly here is a check not made."""
    if not isinstance(data, dict):
        raise BadReport("the report must be a JSON object")

    milestone = str(data.get("milestone", "")).strip()
    if not milestone:
        raise BadReport("no milestone named (`milestone`)")

    try:
        rnd = int(data.get("round", 1))
    except (TypeError, ValueError):
        raise BadReport("`round` must be a number") from None

    raw_checklist = data.get("checklist")
    if not isinstance(raw_checklist, list) or not raw_checklist:
        raise BadReport("`checklist` is empty: the \"done when\" block was not walked")
    checklist = []
    for i, raw in enumerate(raw_checklist):
        if not isinstance(raw, dict):
            raise BadReport(f"checklist[{i}]: expected an object")
        item = str(raw.get("item", "")).strip()
        if not item:
            raise BadReport(f"checklist[{i}]: no `item` text")
        # NOT bool(): every non-empty string is truthy, so `"passed": "false"`
        # — and `"нет"`, and `"not checked"` — read as PASSED, which is also
        # the escape hatch from the failed-item defect below. This format is
        # written by a model, in English or Russian, and models do emit
        # stringified booleans.
        passed = raw.get("passed")
        if not isinstance(passed, bool):
            raise BadReport(
                f"checklist[{i}]: `passed` must be true or false, not "
                f"{passed!r} — a string here reads as passed whatever it says"
            )
        checklist.append(Item(item=item, passed=passed,
                              evidence=_strs(raw.get("evidence"), f"checklist[{i}].evidence")))

    findings = []
    for i, raw in enumerate(data.get("findings") or []):
        if not isinstance(raw, dict):
            raise BadReport(f"findings[{i}]: expected an object")
        klass = ALIASES.get(str(raw.get("class", "")).strip().lower())
        if klass is None:
            raise BadReport(
                f"findings[{i}]: unknown class {raw.get('class')!r} — "
                f"expected one of {', '.join(CLASSES)}"
            )
        what = str(raw.get("what", "")).strip()
        if not what:
            raise BadReport(f"findings[{i}]: no `what` text")
        findings.append(Finding(klass=klass, what=what,
                                where=str(raw.get("where", "")).strip(),
                                evidence=_strs(raw.get("evidence"), f"findings[{i}].evidence")))

    # Type-check BEFORE the `or {}` default: `[] or {}` is `{}`, so an empty
    # list of the wrong shape used to pass as "absent" and a non-empty one
    # crashed with an AttributeError the agent sees as a traceback.
    raw_probes = data.get("beyond_checklist")
    if raw_probes is not None and not isinstance(raw_probes, dict):
        raise BadReport("`beyond_checklist` must be an object of probe → answer")
    raw_probes = raw_probes or {}
    raw_spend = data.get("spend")
    if raw_spend is not None and not isinstance(raw_spend, dict):
        raise BadReport("`spend` must be an object with `actions` and `minutes`")
    probes: dict[str, str] = {}
    for key, value in raw_probes.items():
        canonical = PROBE_ALIASES.get(str(key).strip().lower())
        if canonical:
            probes[canonical] = str(value).strip()

    return Report(
        milestone=milestone,
        round=rnd,
        checklist=tuple(checklist),
        findings=tuple(findings),
        not_checked=str(data.get("not_checked", "")).strip(),
        probes=probes,
        verified_fixed=_strs(data.get("verified_fixed"), "verified_fixed"),
        spend=data.get("spend") or {},
    )


# -- overrides ----------------------------------------------------------------

# `- lifted by owner: <finding text verbatim> — <reason>`. Both languages'
# prefixes are accepted regardless of --lang: a project that switches its
# owner-facing language must not invalidate blocks lifted last month.
_PREFIXES = tuple(lang["override_prefix"] for lang in LABELS.values())
_OVERRIDE_LINE = re.compile(
    r"^\s*-\s*(?:%s)\s*(?P<what>.+?)\s*(?:[—-]\s.*)?$"
    % "|".join(re.escape(p) for p in _PREFIXES),
    re.IGNORECASE,
)


def read_overrides(path: pathlib.Path) -> tuple[str, ...]:
    """Findings the owner has explicitly waved through, by their verbatim text."""
    if not path.is_file():
        return ()
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        match = _OVERRIDE_LINE.match(line)
        if match:
            out.append(match.group("what").strip())
    return tuple(out)


# -- the gate itself ----------------------------------------------------------

def defects(report: Report, *, require_db: bool = True,
            tree: tuple[str, str, tuple[str, ...]] | None = None,
            evidence_dir: pathlib.Path | None = None) -> tuple[str, ...]:
    """Everything that makes the report itself unusable, regardless of findings.

    A report with holes cannot support a "good" verdict, so these block just
    like a breakage does — see this module's docstring.
    """
    out: list[str] = []

    if tree is not None:
        expected, actual, moved = tree
        if actual == "":
            out.append(
                "the working tree could not be fingerprinted, so it is unknown whether "
                "the acceptance run changed the code it was judging"
            )
        elif expected != actual:
            named = ", ".join(moved[:5]) + ("…" if len(moved) > 5 else "")
            out.append(
                f"the working tree changed during the acceptance run: "
                f"{named or '(paths unknown)'}. Someone else fixes what acceptance "
                f"finds; a run that edited the code it was judging is void, not "
                f"passed. If these are generated files, pass --tree-ignore"
            )

    if not report.not_checked:
        out.append(
            'the mandatory "what I could not check and why" line is missing — '
            "its absence reads as a full run, and a full run is rare"
        )

    missing = [p for p in PROBES if not report.probes.get(p)]
    if missing:
        out.append("probes beyond the checklist with no answer: " + ", ".join(missing))

    for item in report.checklist:
        if item.passed and not item.evidence:
            out.append(f'checklist item marked passed with no evidence: "{item.item}"')

    # A "done when" line that did not pass means the milestone is not done.
    # The gate used to consult only findings and defects, so a report could
    # fail half the checklist, file nothing, and still be told it may merge —
    # the written shape of "could not", which is never "good".
    failed = [item.item for item in report.checklist if not item.passed]
    if failed:
        out.append(
            "checklist items that did not pass: "
            + "; ".join(f'"{f}"' for f in failed[:5])
            + ("…" if len(failed) > 5 else "")
            + '. The milestone\'s "done when" is not met'
        )

    everything = [e for item in report.checklist for e in item.evidence]
    everything += [e for f in report.findings for e in f.evidence]

    # EVERY piece of evidence must carry a known prefix, and the match is
    # case-insensitive. This is the fourth defeat of this check and the one
    # that made the other three cheap: the report-wide `any()` below asks
    # whether SOME evidence is a screenshot, while an individual item was
    # satisfied by any non-empty string at all. So one real capture anywhere
    # paid for the whole checklist, and "checked, works" — the exact string
    # this module's docstring promises is refused — went through untouched.
    # `Screen:` with a capital S did too, for want of a `.lower()`.
    # Every evidence string ANYWHERE must carry a prefix — findings included,
    # which they were not before: a finding was exempt from this rule but not
    # from the capture-name rule below. Note the prefix rule alone does not
    # settle it, since "Screen: the field loses focus…" does start with the
    # prefix; the whitespace rule in `_malformed` is what tells prose from a
    # filename.
    unprefixed = sorted({e for item in report.checklist if item.passed
                         for e in item.evidence
                         if not e.lower().startswith((SCREEN, DB))}
                        | {e for f in report.findings for e in f.evidence
                           if not e.lower().startswith((SCREEN, DB))})
    if unprefixed:
        shown = ", ".join(repr(e) for e in unprefixed[:5])
        out.append(
            f"evidence that is neither `{SCREEN}` nor `{DB}`: "
            f"{shown}" + ("…" if len(unprefixed) > 5 else "")
            + ". Prose is not evidence — a claim is paid for with a capture or "
            "a row, and each item pays for itself"
        )

    def _is(prefix: str, e: str) -> bool:
        return e.lower().startswith(prefix)

    def _capture_name(e: str) -> str:
        return e[len(SCREEN):].strip() if _is(SCREEN, e) else ""

    def _malformed(n: str) -> bool:
        """A capture name is ONE plain filename. Every previous version of this
        check was defeated by a string it had not imagined — an empty name, a
        path out of the directory, the report's own name.

        Whitespace is refused for the opposite reason: `shot_name()` cannot
        produce it, and without the rule a finding whose prose begins
        "Screen: the field loses focus…" parses as a filename and blocks the
        merge with "not on disk" — a blameless block with a baffling message.
        Prose gets told it is prose.

        A leading dot goes the same way: `screen:.DS_Store` paid, and
        `.DS_Store` appears the moment somebody opens the evidence folder in
        Finder to look at the screenshots."""
        return (not n or "/" in n or "\\" in n or n in (".", "..")
                or n == REPORT_NAME or any(c.isspace() for c in n)
                or n.startswith(".")
                or pathlib.PurePosixPath(n).is_absolute())

    # `db:` on its own is defeat #2 one prefix over: it satisfies both the
    # per-item rule and `require_db` while saying nothing about any query.
    # The row cannot be verified — the gate has no database — but it can at
    # least be required to exist.
    if any(_is(DB, e) and not e[len(DB):].strip() for e in everything):
        out.append(
            f"`{DB}` with nothing after it — a row that is not quoted is not "
            "a row, and the gate has no database to look it up in"
        )

    if not any(_is(SCREEN, e) for e in everything):
        out.append(f"not one `{SCREEN}` piece of evidence in the whole report")

    # Each passed item must cite a capture of its own — meaning ITS OWN LINE
    # must name one, not that the capture is unique to it. The same screenshot
    # may legitimately show two "done when" lines, so distinctness is NOT
    # required, and the cost of that is honest: one real capture, cited N
    # times, still pays for N items. That is a known and recorded limit, much
    # weaker than what it replaced — `db:` alone used to pay for a whole
    # checklist while the single report-wide `screen:` requirement was
    # satisfied by a screenshot hanging off a non-blocking `clumsy` finding.
    # A `db:` row stays an ADDITIONAL claim, never a sufficient one, because
    # the gate has no database to check it against.
    uncaptured = [item.item for item in report.checklist
                  if item.passed
                  and not any(_is(SCREEN, e) and not _malformed(_capture_name(e))
                              for e in item.evidence)]
    if uncaptured:
        out.append(
            "passed with no capture of its own: "
            + "; ".join(f'"{i}"' for i in uncaptured[:5])
            + ("…" if len(uncaptured) > 5 else "")
            + f". A `{DB}` row is an extra claim, not a substitute — the gate "
            "has no database, which is exactly why the screenshot is required"
        )
    if require_db and not any(_is(DB, e) for e in everything):
        out.append(
            f"not one `{DB}` row in the whole report — a run that never looked at "
            "the data cannot tell working from working-but-lying"
        )

    # WHAT THIS CHECK IS, AND IS NOT. It is hygiene against a lazy or sloppy
    # run, not a boundary against an adversarial one. An acceptance agent holds
    # a shell; it can always `touch 007-saved.png` and quote the name. Nothing
    # here can stop that, and the tripwire does not reach the evidence
    # directory because that directory is deliberately gitignored.
    #
    # What it CAN do is make every *cheap* way of not looking cost more than
    # looking: a filename nobody captured, an empty name, a path out of the
    # directory, an unprefixed sentence, the report naming itself. Each of
    # those was a real defeat, found by a reviewer rather than by reading, and
    # each is now refused. If you are adding a sixth rule here, that is the
    # bar to hold it to — "does this close a way of writing a report without
    # doing the work" — and not "is this unforgeable", which it cannot be.
    #
    # Seven defeats so far, six of them the same mistake in a new spelling —
    # the argument for the shared helpers above. The seventh was not in this
    # function at all: the evidence directory was never cleared between rounds,
    # and it is `acceptance-loop`'s Phase 1 that archives it now.
    #
    # THE REAL FIX, when someone has the appetite: this check asks whether a
    # string looks like a file that exists, when the question it wants to ask
    # is whether the driver did the work. `bin/drive` already knows — it wrote
    # every capture and charged every action. A manifest it appends
    # (`captures.json`: name, timestamp, target, digest of the bytes) would be
    # a file the REPORTING agent did not author, and the gate could then
    # require every cited capture to appear in it and cross-check
    # `spend.actions` against the driver's own count. Still forgeable — the
    # agent holds a shell — but forgery moves from "type a name twice" to
    # "write a consistent fake manifest", which is the cost curve this is
    # reaching for. Narrowing the vocabulary of the lie, one rule at a time,
    # is what produced seven rounds of this.
    #
    # `db:` rows cannot be checked against anything and deliberately are not:
    # they are the agent's prose about what a query returned, and the gate has
    # no database. That asymmetry is the reason a screenshot is cheap to demand
    # — and the reason the screenshot half is checked as hard as it is below.
    if evidence_dir is not None:
        named = [_capture_name(e) for e in everything if _is(SCREEN, e)]
        malformed = sorted({n for n in named if _malformed(n)})
        if malformed:
            shown = ", ".join(repr(n) for n in malformed[:5])
            out.append(
                f"`{SCREEN}` evidence that is not a plain capture filename: {shown}"
                + ("…" if len(malformed) > 5 else "")
                + f". It must be one file in {evidence_dir}, named exactly as "
                "the driver wrote it — not a path, not empty, and with no "
                "spaces in it. A sentence here is prose, not a capture"
            )
        # Real files only: `os.listdir` counted a directory named like a
        # capture, and following a symlink would make "named exactly as the
        # driver wrote it" untrue. Compared under NFC as well as byte-for-byte
        # so a Cyrillic or accented capture name — which `shot_name` passes
        # through unchanged, and `language: ru` makes ordinary — is not
        # rejected over a normalisation the two sides spell differently.
        try:
            with os.scandir(evidence_dir) as it:
                present = {e.name for e in it if e.is_file(follow_symlinks=False)}
        except OSError:
            present = set()
        folded = {unicodedata.normalize("NFC", n) for n in present}
        absent = sorted({n for n in named
                         if n and n not in malformed and n not in present
                         and unicodedata.normalize("NFC", n) not in folded})
        if absent:
            out.append(
                "evidence names screenshots that are not in "
                f"{evidence_dir}: {', '.join(absent[:5])}"
                + ("…" if len(absent) > 5 else "")
                + ". A capture that is not on disk did not happen"
            )

    return tuple(out)


def gate(report: Report, *, overrides: tuple[str, ...] = (),
         require_db: bool = True,
         tree: tuple[str, str, tuple[str, ...]] | None = None,
         evidence_dir: pathlib.Path | None = None) -> Decision:
    lifted, blockers = [], []
    for finding in report.findings:
        if finding.klass not in BLOCKING:
            continue
        (lifted if finding.what in overrides else blockers).append(finding)

    found = defects(report, require_db=require_db, tree=tree,
                    evidence_dir=evidence_dir)
    return Decision(
        blocked=bool(blockers or found),
        blockers=tuple(blockers),
        lifted=tuple(lifted),
        defects=found,
        advisory=tuple(f for f in report.findings if f.klass == CLUMSY),
    )


# -- rendering ----------------------------------------------------------------

def _finding_line(finding: Finding, lang: str) -> str:
    where = f" ({finding.where})" if finding.where else ""
    evidence = f" [{', '.join(finding.evidence)}]" if finding.evidence else ""
    return f"- **{label(lang, finding.klass)}** — {finding.what}{where}{evidence}"


def render(report: Report, decision: Decision, lang: str = "en") -> str:
    head = label(lang, "blocked") if decision.blocked else label(lang, "good")
    lines = [
        f"# {label(lang, 'verdict')} · {report.milestone} · "
        f"{label(lang, 'round')} {report.round}: {head}",
        "",
    ]

    if decision.blockers:
        lines += [f"## {label(lang, 'blockers')}", ""]
        lines += [_finding_line(f, lang) for f in decision.blockers] + [""]

    if decision.defects:
        lines += [f"## {label(lang, 'defects')}", ""]
        lines += [f"- {d}" for d in decision.defects] + [""]

    if decision.lifted:
        lines += [f"## {label(lang, 'lifted')}", ""]
        lines += [_finding_line(f, lang) for f in decision.lifted] + [""]

    if decision.advisory:
        lines += [f"## {label(lang, 'advisory')}", ""]
        lines += [_finding_line(f, lang) for f in decision.advisory] + [""]

    if report.verified_fixed:
        lines += [f"## {label(lang, 'verified_fixed')}", ""]
        lines += [f"- {v}" for v in report.verified_fixed] + [""]

    lines += [
        f"## {label(lang, 'not_checked')}",
        "",
        report.not_checked or "—",
        "",
    ]

    spend = report.spend or {}
    lines.append(
        f"{label(lang, 'spend')}: {spend.get('actions', '?')} "
        f"{label(lang, 'actions')}, {spend.get('minutes', '?')} "
        f"{label(lang, 'minutes')}."
    )
    return "\n".join(lines) + "\n"


# -- CLI ----------------------------------------------------------------------

TEMPLATE: dict[str, Any] = {
    "milestone": "<milestone>",
    "round": 1,
    "checklist": [
        {
            "item": "<one line of the milestone's \"done when\" block, verbatim>",
            "passed": True,
            "evidence": ["screen:007-saved.png", "db:SELECT … → 1 row, config updated"],
        }
    ],
    # Empty, filled by the run. The example alongside shows the shape; the
    # skeleton passes the gate as soon as its placeholder capture exists on
    # disk, on purpose — a contract handed to an agent must be self-consistent,
    # or the first run fights the parser instead of the feature. It does NOT
    # pass with no capture at all, and must not: that is the whole point of the
    # evidence check in `defects()`.
    "findings": [],
    "_example_finding": {
        "class": BROKEN,
        "what": "<what is wrong, in a human's words>",
        "where": "<where exactly: screen, button, address>",
        "evidence": ["screen:012-after-click.png"],
    },
    "beyond_checklist": dict.fromkeys(PROBES, "<what happened>"),
    # Round >= 2 only: what the previous round found and you confirmed is fixed.
    # These are not findings — do not file them as `clumsy` to get them seen.
    "verified_fixed": [],
    "not_checked": "<what you could not check and why — this line is mandatory>",
    "spend": {"actions": 0, "minutes": 0},
}


def verdict_path(milestone: str, root: pathlib.Path) -> pathlib.Path:
    return root / milestone / REPORT_NAME


def override_path(milestone: str, tracker: pathlib.Path) -> pathlib.Path:
    return tracker / milestone / "acceptance-override.md"


def run_gate(milestone: str, *, write: bool, tracker: pathlib.Path,
             root: pathlib.Path, lang: str, require_db: bool,
             expect_tree: str | None = None,
             tree_ignore: tuple[str, ...] = ()) -> int:
    path = verdict_path(milestone, root)
    if not path.is_file():
        # No report is "could not", never "good". A run that did not happen
        # never signs off on anything.
        print(f"[verdict] no {path}: the acceptance run left no report. "
              f'That is "could not", not "good".', file=sys.stderr)
        return 1
    try:
        report = parse(json.loads(path.read_text(encoding="utf-8")))
    except (json.JSONDecodeError, BadReport) as exc:
        print(f"[verdict] the report does not parse: {exc}", file=sys.stderr)
        return 1

    tree = None
    if expect_tree:
        try:
            digest, moved = tree_state(ignore=tree_ignore)
            tree = (expect_tree, digest, moved)
        except (subprocess.SubprocessError, OSError, FileNotFoundError):
            tree = (expect_tree, "", ())   # fail closed: unknown is not unchanged

    decision = gate(report,
                    overrides=read_overrides(override_path(milestone, tracker)),
                    require_db=require_db, tree=tree,
                    evidence_dir=path.parent)
    text = render(report, decision, lang)
    print(text)
    if write:
        # NOT `acceptance.md`: that file is the OWNER's ledger of what
        # acceptance missed after a green verdict, written by hand over the
        # life of a milestone. `--write` truncates whatever it is pointed at,
        # and every later round pointed it at the owner's own notes.
        out = tracker / milestone / "acceptance-verdict.md"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(text, encoding="utf-8")
        print(f"[verdict] written to {out}", file=sys.stderr)
    return 1 if decision.blocked else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="aikit acceptance gate")
    sub = parser.add_subparsers(dest="command", required=True)

    gated = sub.add_parser("gate", help="0 — may merge, 1 — blocked")
    gated.add_argument("milestone")
    gated.add_argument("--write", action="store_true",
                       help="also write the verdict text into the milestone's tracker")
    gated.add_argument("--tracker", type=pathlib.Path, default=pathlib.Path("docs/tracker"))
    gated.add_argument("--evidence-root", dest="root", type=pathlib.Path,
                       default=pathlib.Path(".acceptance"))
    gated.add_argument("--lang", default="en", choices=sorted(LABELS))
    gated.add_argument("--no-db", dest="require_db", action="store_false",
                       help="the project has no database the acceptance role can read")
    gated.add_argument("--expect-tree", metavar="DIGEST",
                       help="the `verdict tree` digest taken before the acceptance run; "
                            "the gate blocks if the working tree moved during it")
    gated.add_argument("--tree-ignore", metavar="GLOB", action="append", default=[],
                       help="generated paths the tripwire should not count (repeatable). "
                            "A bare name matches any path component: __pycache__")

    template = sub.add_parser("template", help="empty report skeleton on stdout")
    template.add_argument("milestone")

    tree = sub.add_parser("tree", help="fingerprint the working tree (record before an acceptance run)")
    tree.add_argument("--tree-ignore", metavar="GLOB", action="append", default=[],
                      help="generated paths to leave out of the fingerprint (repeatable)")
    tree.add_argument("--show", action="store_true", help="also list what is currently dirty")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.command == "template":
        print(json.dumps(dict(TEMPLATE, milestone=args.milestone),
                         ensure_ascii=False, indent=2))
        return 0
    if args.command == "tree":
        try:
            digest, moved = tree_state(ignore=tuple(args.tree_ignore))
        except (subprocess.SubprocessError, OSError, FileNotFoundError) as exc:
            print(f"[verdict] cannot fingerprint the working tree: {exc}", file=sys.stderr)
            return 1
        print(digest)
        if args.show:
            for path in moved:
                print(f"  dirty: {path}", file=sys.stderr)
        return 0
    return run_gate(args.milestone, write=args.write, tracker=args.tracker,
                    root=args.root, lang=args.lang, require_db=args.require_db,
                    expect_tree=args.expect_tree, tree_ignore=tuple(args.tree_ignore))


if __name__ == "__main__":
    raise SystemExit(main())
